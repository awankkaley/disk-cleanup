#!/usr/bin/env bats

load helpers/common

setup() {
  setup_sandbox
  CODE="$SANDBOX_HOME/code"
}
teardown() { teardown_sandbox; }

stale() { json cat node-modules-stale "$1"; }

@test "an idle project with a lockfile is counted in its bucket" {
  make_project "$CODE/idle-app" 40
  run_cleanup scan --deep
  assert_json_schema scan
  [ "$(stale status)" = "ok" ]
  [ "$(stale item_count)" = "1" ]
  [ "$(stale size_bytes)" -ge 16384 ]
  [ "$(json bucket 30-90 project_count)" = "1" ]
  [ "$(json bucket 30-90 size_bytes)" = "$(stale size_bytes)" ]
  [ "$(json bucket 90-180 project_count)" = "0" ]
  [ "$(json bucket 180+ project_count)" = "0" ]
}

@test "projects are sorted into the three idle buckets" {
  make_project "$CODE/one" 45
  make_project "$CODE/two" 100
  make_project "$CODE/three" 170 yarn.lock
  make_project "$CODE/four" 400 pnpm-lock.yaml
  make_project "$CODE/five" 10
  run_cleanup scan --deep
  [ "$(stale item_count)" = "4" ]
  [ "$(json bucket 30-90 project_count)" = "1" ]
  [ "$(json bucket 30-90 min_idle_days)" = "30" ]
  [ "$(json bucket 90-180 project_count)" = "2" ]
  [ "$(json bucket 90-180 min_idle_days)" = "90" ]
  [ "$(json bucket 180+ project_count)" = "1" ]
  [ "$(json bucket 180+ min_idle_days)" = "180" ]
}

@test "every supported lockfile qualifies" {
  local lockfile index=0
  for lockfile in package-lock.json yarn.lock pnpm-lock.yaml bun.lock bun.lockb; do
    index=$((index + 1))
    make_project "$CODE/app-$index" 60 "$lockfile"
  done
  run_cleanup scan --deep
  [ "$(stale item_count)" = "5" ]
}

@test "a project without a lockfile never qualifies" {
  make_project "$CODE/no-lock" 200 none
  run_cleanup scan --deep
  [ "$(stale status)" = "empty" ]
  [ "$(stale item_count)" = "0" ]
}

@test "a node_modules without a sibling package.json never qualifies" {
  make_project "$CODE/no-manifest" 200
  rm "$CODE/no-manifest/package.json"
  age_tree "$CODE/no-manifest" 200
  run_cleanup scan --deep
  [ "$(stale item_count)" = "0" ]
}

@test "a recently modified source file keeps the project active" {
  make_project "$CODE/active" 200
  touch "$CODE/active/src/index.js"
  run_cleanup scan --deep
  [ "$(stale item_count)" = "0" ]
}

@test "recent git activity keeps the project active" {
  make_project "$CODE/committed" 200
  make_file "$CODE/committed/.git/index" 1
  make_file "$CODE/committed/.git/HEAD" 1
  make_file "$CODE/committed/.git/objects/ab/blob" 1
  age_tree "$CODE/committed" 200
  touch "$CODE/committed/.git/HEAD"
  run_cleanup scan --deep
  [ "$(stale item_count)" = "0" ]
}

@test "git internals other than index and HEAD are ignored" {
  make_project "$CODE/fetched" 200
  make_file "$CODE/fetched/.git/index" 1
  make_file "$CODE/fetched/.git/HEAD" 1
  age_tree "$CODE/fetched" 200
  make_file "$CODE/fetched/.git/objects/ab/blob" 1
  age_path "$CODE/fetched/.git" 200
  run_cleanup scan --deep
  [ "$(stale item_count)" = "1" ]
}

@test "changes inside node_modules do not count as activity" {
  make_project "$CODE/idle-app" 200
  touch "$CODE/idle-app/node_modules/left-pad/index.js"
  run_cleanup scan --deep
  [ "$(stale item_count)" = "1" ]
}

@test "a symlinked node_modules never qualifies" {
  make_project "$CODE/linked" 200
  mv "$CODE/linked/node_modules" "$OUTSIDE/real-modules"
  ln -s "$OUTSIDE/real-modules" "$CODE/linked/node_modules"
  age_tree "$CODE/linked" 200
  scan_for_token --deep
  [ "$(stale item_count)" = "0" ]
}

@test "nested node_modules, dot-directories and Library are never descended" {
  make_project "$CODE/idle-app" 200
  make_project "$CODE/idle-app/node_modules/inner-pkg" 200
  make_project "$SANDBOX_HOME/.hidden/tool" 200
  make_project "$SANDBOX_HOME/Library/Application Support/SomeApp/bundle" 200
  make_project "$SANDBOX_HOME/.Trash/thrown-away" 200
  age_tree "$CODE/idle-app" 200
  scan_for_token --deep
  [ "$(stale item_count)" = "1" ]
  clean_categories node-modules-stale
  [ "$(json res node-modules-stale status)" = "cleaned" ]
  assert_exists "$SANDBOX_HOME/.hidden/tool/node_modules/left-pad/index.js"
  assert_exists "$SANDBOX_HOME/Library/Application Support/SomeApp/bundle/node_modules/left-pad/index.js"
  assert_exists "$SANDBOX_HOME/.Trash/thrown-away/node_modules/left-pad/index.js"
}

@test "--projects-dir limits the walk" {
  make_project "$CODE/inside" 200
  make_project "$SANDBOX_HOME/elsewhere/outside" 200
  scan_for_token --deep --projects-dir "$CODE"
  [ "$(stale item_count)" = "1" ]
  clean_categories node-modules-stale
  [ "$status" -eq 0 ]
  assert_missing "$CODE/inside/node_modules"
  assert_exists "$SANDBOX_HOME/elsewhere/outside/node_modules/left-pad/index.js"
}

@test "clean removes the whole node_modules and nothing else of the project" {
  make_project "$CODE/idle-app" 200
  make_project "$CODE/active-app" 5
  scan_for_token --deep
  clean_categories node-modules-stale
  [ "$status" -eq 0 ]
  assert_json_schema clean
  [ "$(json res node-modules-stale status)" = "cleaned" ]
  [ "$(json res node-modules-stale freed_bytes)" -ge 16384 ]
  [ "$(json res node-modules-stale error_code)" = "null" ]
  assert_missing "$CODE/idle-app/node_modules"
  assert_exists "$CODE/idle-app/package.json"
  assert_exists "$CODE/idle-app/package-lock.json"
  assert_exists "$CODE/idle-app/src/index.js"
  assert_exists "$CODE/active-app/node_modules/left-pad/index.js"
}

@test "--min-idle-days keeps projects idle for less than the threshold" {
  make_project "$CODE/short-idle" 45
  make_project "$CODE/long-idle" 120
  scan_for_token --deep
  [ "$(stale item_count)" = "2" ]
  clean_categories node-modules-stale --min-idle-days 90
  [ "$status" -eq 0 ]
  assert_exists "$CODE/short-idle/node_modules/left-pad/index.js"
  assert_missing "$CODE/long-idle/node_modules"
}

@test "a project touched after the scan is spared by the clean" {
  make_project "$CODE/revived" 200
  make_project "$CODE/idle-app" 200
  scan_for_token --deep
  touch "$CODE/revived/src/index.js"
  clean_categories node-modules-stale
  [ "$status" -eq 0 ]
  assert_exists "$CODE/revived/node_modules/left-pad/index.js"
  assert_missing "$CODE/idle-app/node_modules"
}

@test "idle projects below Documents are found and cleaned" {
  make_project "$SANDBOX_HOME/Documents/Projects/idle-app" 200
  make_file "$SANDBOX_HOME/Documents/Projects/notes.txt" 1
  scan_for_token --deep
  [ "$(stale item_count)" = "1" ]
  clean_categories node-modules-stale
  [ "$(json res node-modules-stale status)" = "cleaned" ]
  assert_missing "$SANDBOX_HOME/Documents/Projects/idle-app/node_modules"
  assert_exists "$SANDBOX_HOME/Documents/Projects/idle-app/src/index.js"
  assert_exists "$SANDBOX_HOME/Documents/Projects/notes.txt"
}

@test "project names never reach the output" {
  make_project "$CODE/secret-client-portal" 200
  scan_for_token --deep
  assert_private secret-client-portal left-pad
  clean_categories node-modules-stale
  assert_private secret-client-portal left-pad
}

@test "an undeletable node_modules is reported without touching the project" {
  make_project "$CODE/locked-app" 200
  chmod 500 "$CODE/locked-app/node_modules/left-pad"
  scan_for_token --deep
  clean_categories node-modules-stale
  [ "$status" -eq 0 ]
  [ "$(json res node-modules-stale status)" = "skipped_no_permission" ]
  [ "$(json res node-modules-stale error_code)" != "null" ]
  assert_exists "$CODE/locked-app/package.json"
}

@test "nothing qualifying at clean time is not_found" {
  make_project "$CODE/idle-app" 200
  scan_for_token --deep
  touch "$CODE/idle-app/src/index.js"
  clean_categories node-modules-stale
  [ "$(json res node-modules-stale status)" = "not_found" ]
  assert_exists "$CODE/idle-app/node_modules/left-pad/index.js"
}

@test "projects inside the Applications folder or an app bundle never qualify" {
  make_project "$SANDBOX_HOME/Applications/Tool/resources" 200
  make_project "$SANDBOX_HOME/Applications/Editor.app/Contents/Resources/app" 200
  make_project "$CODE/builds/Shell.app/Contents/Resources/app" 200
  make_project "$CODE/idle-app" 200
  scan_for_token --deep
  [ "$(stale item_count)" = "1" ]
  clean_categories node-modules-stale
  [ "$(json res node-modules-stale status)" = "cleaned" ]
  assert_missing "$CODE/idle-app/node_modules"
  assert_exists "$SANDBOX_HOME/Applications/Tool/resources/node_modules/left-pad/index.js"
  assert_exists "$SANDBOX_HOME/Applications/Editor.app/Contents/Resources/app/node_modules/left-pad/index.js"
  assert_exists "$CODE/builds/Shell.app/Contents/Resources/app/node_modules/left-pad/index.js"
}

@test "a projects dir below the Applications folder yields nothing" {
  make_project "$SANDBOX_HOME/Applications/Tool/resources" 200
  run_cleanup scan --deep --projects-dir "$SANDBOX_HOME/Applications/Tool"
  [ "$status" -eq 0 ]
  [ "$(stale item_count)" = "0" ]
}

@test "projects linked into the global npm root never qualify" {
  local global="$SANDBOX/global/lib/node_modules"
  make_project "$CODE/linked-cli" 200
  make_project "$CODE/scoped-cli" 200
  make_project "$CODE/idle-app" 200
  mkdir -p "$global/@scope" "$global/regular-package"
  ln -s "$CODE/linked-cli" "$global/linked-cli"
  ln -s "$CODE/scoped-cli" "$global/@scope/scoped-cli"
  stub_cache_tool npm "root -g" "$global"
  scan_for_token --deep
  [ "$(stale item_count)" = "1" ]
  clean_categories node-modules-stale
  [ "$(json res node-modules-stale status)" = "cleaned" ]
  assert_missing "$CODE/idle-app/node_modules"
  assert_exists "$CODE/linked-cli/node_modules/left-pad/index.js"
  assert_exists "$CODE/scoped-cli/node_modules/left-pad/index.js"
}

@test "without npm the linked-project check is skipped quietly" {
  make_project "$CODE/idle-app" 200
  run_cleanup scan --deep
  [ "$(stale item_count)" = "1" ]
}
